<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1"
  targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Usuario" name="Usuário / Estudante" processRef="Process_Usuario" />
    <bpmn:participant id="Participant_Frontend" name="Frontend (TypeScript + Vite)" processRef="Process_Frontend" />
    <bpmn:participant id="Participant_Backend" name="Backend (Django + API)" processRef="Process_Backend" />
    <bpmn:participant id="Participant_DB" name="PostgreSQL" processRef="Process_DB" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Usuario" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Acesso ao sistema" />
    <bpmn:task id="Task_VisitHome" name="Acessa landing page e navega" />
    <bpmn:task id="Task_Login" name="Faz login ou cadastro" />
    <bpmn:task id="Task_Study" name="Estuda trilhas, lições e prática" />
    <bpmn:task id="Task_Progress" name="Consulta progresso e gamificação" />
    <bpmn:endEvent id="EndEvent_1" name="Fluxo concluído" />

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_VisitHome" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_VisitHome" targetRef="Task_Login" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Login" targetRef="Task_Study" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Study" targetRef="Task_Progress" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Progress" targetRef="EndEvent_1" />
  </bpmn:process>

  <bpmn:process id="Process_Frontend" isExecutable="false">
    <bpmn:task id="Task_RenderHome" name="Renderiza página inicial / rotas" />
    <bpmn:task id="Task_AuthUI" name="Exibe cadastro, login e recuperação de senha" />
    <bpmn:task id="Task_ShowDashboard" name="Exibe painel, trilhas e glossário" />
    <bpmn:task id="Task_Playground" name="Disponibiliza prática musical e piano virtual" />
    <bpmn:task id="Task_AdminUI" name="Disponibiliza área administrativa" />

    <bpmn:sequenceFlow id="Flow_F1" sourceRef="Task_RenderHome" targetRef="Task_AuthUI" />
    <bpmn:sequenceFlow id="Flow_F2" sourceRef="Task_AuthUI" targetRef="Task_ShowDashboard" />
    <bpmn:sequenceFlow id="Flow_F3" sourceRef="Task_ShowDashboard" targetRef="Task_Playground" />
    <bpmn:sequenceFlow id="Flow_F4" sourceRef="Task_Playground" targetRef="Task_AdminUI" />
  </bpmn:process>

  <bpmn:process id="Process_Backend" isExecutable="false">
    <bpmn:task id="Task_ValidateAuth" name="Valida credenciais e sessão" />
    <bpmn:task id="Task_ManageTriagem" name="Processa triagem e nível inicial" />
    <bpmn:task id="Task_ManageLearning" name="Gerencia trilhas, lições e progresso" />
    <bpmn:task id="Task_ManageGlossary" name="Consulta termos e conceitos do glossário" />
    <bpmn:task id="Task_Audit" name="Registra eventos de auditoria e segurança" />
    <bpmn:task id="Task_AI" name="Expõe integrações de assistente de IA" />

    <bpmn:sequenceFlow id="Flow_B1" sourceRef="Task_ValidateAuth" targetRef="Task_ManageTriagem" />
    <bpmn:sequenceFlow id="Flow_B2" sourceRef="Task_ManageTriagem" targetRef="Task_ManageLearning" />
    <bpmn:sequenceFlow id="Flow_B3" sourceRef="Task_ManageLearning" targetRef="Task_ManageGlossary" />
    <bpmn:sequenceFlow id="Flow_B4" sourceRef="Task_ManageGlossary" targetRef="Task_Audit" />
    <bpmn:sequenceFlow id="Flow_B5" sourceRef="Task_Audit" targetRef="Task_AI" />
  </bpmn:process>

  <bpmn:process id="Process_DB" isExecutable="false">
    <bpmn:task id="Task_SaveData" name="Persiste usuários, trilhas, progresso, conteúdo e auditoria" />
    <bpmn:task id="Task_ReadData" name="Retorna dados para frontend e APIs" />
    <bpmn:sequenceFlow id="Flow_DB1" sourceRef="Task_SaveData" targetRef="Task_ReadData" />
  </bpmn:process>

  <bpmn:messageFlow id="MF_1" sourceRef="Task_Login" targetRef="Task_ValidateAuth" />
  <bpmn:messageFlow id="MF_2" sourceRef="Task_ValidateAuth" targetRef="Task_SaveData" />
  <bpmn:messageFlow id="MF_3" sourceRef="Task_SaveData" targetRef="Task_ReadData" />
  <bpmn:messageFlow id="MF_4" sourceRef="Task_Study" targetRef="Task_ManageLearning" />
  <bpmn:messageFlow id="MF_5" sourceRef="Task_ManageLearning" targetRef="Task_ShowDashboard" />
  <bpmn:messageFlow id="MF_6" sourceRef="Task_Playground" targetRef="Task_ManageLearning" />
  <bpmn:messageFlow id="MF_7" sourceRef="Task_AdminUI" targetRef="Task_Audit" />
  <bpmn:messageFlow id="MF_8" sourceRef="Task_ShowDashboard" targetRef="Task_ManageGlossary" />
  <bpmn:messageFlow id="MF_9" sourceRef="Task_ManageLearning" targetRef="Task_AI" />

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_Usuario_di" bpmnElement="Participant_Usuario" isHorizontal="true">
        <dc:Bounds x="40" y="20" width="1180" height="150"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Frontend_di" bpmnElement="Participant_Frontend" isHorizontal="true">
        <dc:Bounds x="40" y="190" width="1180" height="150"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Backend_di" bpmnElement="Participant_Backend" isHorizontal="true">
        <dc:Bounds x="40" y="360" width="1180" height="180"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_DB_di" bpmnElement="Participant_DB" isHorizontal="true">
        <dc:Bounds x="40" y="560" width="1180" height="120"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="100" y="70" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_VisitHome_di" bpmnElement="Task_VisitHome">
        <dc:Bounds x="180" y="48" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Login_di" bpmnElement="Task_Login">
        <dc:Bounds x="370" y="48" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Study_di" bpmnElement="Task_Study">
        <dc:Bounds x="560" y="48" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Progress_di" bpmnElement="Task_Progress">
        <dc:Bounds x="770" y="48" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="980" y="70" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_RenderHome_di" bpmnElement="Task_RenderHome">
        <dc:Bounds x="180" y="210" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AuthUI_di" bpmnElement="Task_AuthUI">
        <dc:Bounds x="370" y="210" width="170" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ShowDashboard_di" bpmnElement="Task_ShowDashboard">
        <dc:Bounds x="580" y="210" width="180" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Playground_di" bpmnElement="Task_Playground">
        <dc:Bounds x="790" y="210" width="180" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AdminUI_di" bpmnElement="Task_AdminUI">
        <dc:Bounds x="1000" y="210" width="170" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ValidateAuth_di" bpmnElement="Task_ValidateAuth">
        <dc:Bounds x="240" y="390" width="170" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ManageTriagem_di" bpmnElement="Task_ManageTriagem">
        <dc:Bounds x="440" y="390" width="170" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ManageLearning_di" bpmnElement="Task_ManageLearning">
        <dc:Bounds x="650" y="390" width="190" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ManageGlossary_di" bpmnElement="Task_ManageGlossary">
        <dc:Bounds x="870" y="390" width="170" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Audit_di" bpmnElement="Task_Audit">
        <dc:Bounds x="1050" y="390" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AI_di" bpmnElement="Task_AI">
        <dc:Bounds x="1010" y="470" width="170" height="60"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SaveData_di" bpmnElement="Task_SaveData">
        <dc:Bounds x="240" y="590" width="240" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReadData_di" bpmnElement="Task_ReadData">
        <dc:Bounds x="560" y="590" width="240" height="70"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="136" y="88"/><di:waypoint x="180" y="88"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="330" y="88"/><di:waypoint x="370" y="88"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="520" y="88"/><di:waypoint x="560" y="88"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="720" y="88"/><di:waypoint x="770" y="88"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="930" y="88"/><di:waypoint x="980" y="88"/></bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_F1_di" bpmnElement="Flow_F1"><di:waypoint x="330" y="250"/><di:waypoint x="370" y="250"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_F2_di" bpmnElement="Flow_F2"><di:waypoint x="540" y="250"/><di:waypoint x="580" y="250"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_F3_di" bpmnElement="Flow_F3"><di:waypoint x="760" y="250"/><di:waypoint x="790" y="250"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_F4_di" bpmnElement="Flow_F4"><di:waypoint x="970" y="250"/><di:waypoint x="1000" y="250"/></bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_B1_di" bpmnElement="Flow_B1"><di:waypoint x="410" y="430"/><di:waypoint x="440" y="430"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B2_di" bpmnElement="Flow_B2"><di:waypoint x="610" y="430"/><di:waypoint x="650" y="430"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B3_di" bpmnElement="Flow_B3"><di:waypoint x="840" y="430"/><di:waypoint x="870" y="430"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B4_di" bpmnElement="Flow_B4"><di:waypoint x="1040" y="430"/><di:waypoint x="1050" y="430"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B5_di" bpmnElement="Flow_B5"><di:waypoint x="1110" y="470"/><di:waypoint x="1110" y="470"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_DB1_di" bpmnElement="Flow_DB1"><di:waypoint x="480" y="625"/><di:waypoint x="560" y="625"/></bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MF_1_di" bpmnElement="MF_1"><di:waypoint x="445" y="128"/><di:waypoint x="445" y="390"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_2_di" bpmnElement="MF_2"><di:waypoint x="325" y="470"/><di:waypoint x="325" y="590"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_3_di" bpmnElement="MF_3"><di:waypoint x="680" y="590"/><di:waypoint x="680" y="470"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_4_di" bpmnElement="MF_4"><di:waypoint x="640" y="128"/><di:waypoint x="640" y="390"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_5_di" bpmnElement="MF_5"><di:waypoint x="760" y="290"/><di:waypoint x="760" y="390"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_6_di" bpmnElement="MF_6"><di:waypoint x="880" y="290"/><di:waypoint x="880" y="390"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_7_di" bpmnElement="MF_7"><di:waypoint x="1090" y="290"/><di:waypoint x="1090" y="390"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_8_di" bpmnElement="MF_8"><di:waypoint x="670" y="290"/><di:waypoint x="930" y="390"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_9_di" bpmnElement="MF_9"><di:waypoint x="845" y="470"/><di:waypoint x="1010" y="470"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

